# Copie para .env.local para rodar localmente.
# Em produção isso vive em Vercel > Settings > Environment Variables.

# URL base da API, SEM barra no final.
# Produção: https://api.thiagosiena.com
# Local:    http://127.0.0.1:8000
#
# Obrigatória no build de produção — o vite.config.js aborta o build sem ela,
# de propósito (ver comentário lá). Defina para Production E Preview na Vercel.
VITE_API_URL=http://127.0.0.1:8000
